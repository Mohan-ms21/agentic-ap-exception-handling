# --- Dependencies ---
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Next.js / build output ---
.next/
out/
build/
dist/
next-env.d.ts
*.tsbuildinfo
.vercel

# --- Testing ---
coverage/
playwright-report/
test-results/

# --- Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
*.log

# --- Environment & secrets ---
# Ignore every env file; only the placeholder template is committed.
.env
.env*
!.env.example
*.pem
*.key
*.p12
secrets/

# --- Real (non-mock) data must never be committed ---
data/real/
*.real.json

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Editors / local tooling ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.claude/settings.local.json
