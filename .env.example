# Copy to .env.local and fill in real values. .env.local is gitignored.
#   cp .env.example .env.local
#
# Never commit real values. Server-only secrets must NOT use the
# NEXT_PUBLIC_ prefix — anything with that prefix is bundled into the
# browser and visible to every visitor.

# --- Data source -------------------------------------------------------
# Which backend the UI talks to: mock | n8n | langgraph
# "mock" needs no other configuration.
NEXT_PUBLIC_DATA_SOURCE=mock

# --- n8n webhook backend (server-only) ---------------------------------
# Production webhook URL of the exception-handling workflow.
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/replace-me
# Shared secret sent as a header on each request and validated by n8n.
N8N_WEBHOOK_AUTH_TOKEN=replace-with-a-long-random-string

# --- LangGraph backend (server-only, planned) --------------------------
# LANGGRAPH_API_URL=http://localhost:2024
# LANGGRAPH_API_KEY=replace-me
